# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Backend (replace before deploying)
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/scamshield
DATABASE_URL=sqlite:///./scamshield.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=60/minute
FREE_MONTHLY_LIMIT=25
# Server-side only. Never expose this as a VITE_ variable or in frontend code.
GOOGLE_WEB_RISK_API_KEY=
